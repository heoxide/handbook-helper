{
  "name": "handbook-helper",
  "version": "0.0.4",
  "description": "D&D 5e companion app powered by 5e.tools data",
  "main": "out/main/index.js",
  "author": "Handbook Helper",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && node scripts/clean-release.mjs && electron-builder && powershell -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "clean:release": "node scripts/clean-release.mjs",
    "sync-data": "node scripts/sync-data.mjs",
    "extract-sources": "node scripts/extract-sources.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.handbookhelper.app",
    "productName": "Handbook Helper",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.games",
      "artifactName": "Handbook-Helper-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Handbook-Helper-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Handbook Helper"
    },
    "portable": {
      "artifactName": "Handbook-Helper-Portable.${ext}"
    }
  }
}
